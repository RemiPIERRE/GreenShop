{% extends 'base.html.twig' %}

{% block title %}Catalogue — GreenShop{% endblock %}

{% block body %}

    <section class="catalogue">
        <div class="shell">

            <div class="catalogue-head">
                <div>
                    <p class="eyebrow">Sorties de serre</p>
                    <h1>Le catalogue</h1>
                    <p class="catalogue-count">{{ products|length }} plante(s) disponible(s)</p>
                </div>

                <form class="search-form" method="get" action="{{ path('app_product_search') }}">
                    <input type="search" name="q" placeholder="Chercher une plante…" aria-label="Chercher une plante">
                    <button class="btn btn-primary btn-small" type="submit">Chercher</button>
                </form>
            </div>

            <div class="products-grid">
                {% for product in products %}
                    {% include 'partials/_product_card.html.twig' with {
                        product: product,
                        available: stockMap[product.id]
                    } %}
                {% else %}
                    <div class="empty">
                        <h3>Rien en rayon</h3>
                        <p>Aucune plante active pour le moment.</p>
                    </div>
                {% endfor %}
            </div>

        </div>
    </section>

{% endblock %}
