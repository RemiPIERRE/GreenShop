<article class="tag">

    <div class="tag-visual"{% if not product.image %} aria-hidden="true"{% endif %}>
        {% if product.image %}
            <img src="{{ asset('uploads/products/' ~ product.image) }}" alt="{{ product.name }}">
        {% else %}
            {{ product.name|first|upper }}
        {% endif %}
    </div>

    <div class="tag-body">

        <h3 class="tag-name">
            <a href="{{ path('app_product_show', {id: product.id}) }}">
                {{ product.name|trim|capitalize }}
            </a>
        </h3>

        <p class="tag-desc">{{ product.description }}</p>

        <div class="tag-specs">
            <div>
                <span>Prix</span>
                <span class="price">{{ product.price|number_format(2, ',', ' ') }} €</span>
            </div>
            <div>
                <span>Stock</span>
                {% if available > 0 %}
                    <span class="in-stock">{{ available }} disponible{{ available > 1 ? 's' }}</span>
                {% else %}
                    <span class="out-stock">épuisé</span>
                {% endif %}
            </div>
        </div>

        <div class="tag-actions">
            <a class="btn btn-outline btn-small" href="{{ path('app_product_show', {id: product.id}) }}">
                Détail
            </a>

            {% if available > 0 %}
                <form method="post" action="{{ path('app_cart_add', {id: product.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('cart-add-' ~ product.id) }}">
                    <button class="btn btn-primary btn-small" type="submit">Ajouter</button>
                </form>
            {% else %}
                <span class="btn btn-small btn-disabled">Épuisé</span>
            {% endif %}
        </div>

</article>
