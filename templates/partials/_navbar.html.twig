                {% else %}
                    <li><a class="nav-admin" href="{{ path('app_account_index') }}">Mon compte</a></li>
                {% endif %}
            {% else %}
                <li><a class="nav-admin" href="{{ path('app_login') }}">Connexion</a></li>
            {% endif %}
        </ul>
    </div>
</nav>
