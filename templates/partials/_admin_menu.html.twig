    </li>
    <li>
        <a href="{{ path('app_admin_order_index') }}">Commandes</a>
    </li>
    <li>
        <a href="{{ path('app_admin_plants') }}"
           class="{{ route starts with 'app_admin_product' or route == 'app_admin_plants' ? 'is-active' }}">Plantes</a>
    </li>
    <li>
        <a class="dash-exit" href="{{ path('app_logout') }}">Déconnexion</a>
    </li>
</ul>
