{% set route = app.request.attributes.get('_route') %}

<ul class="dash-menu">
    <li>
        <a href="{{ path('app_account_index') }}"
           class="{{ route == 'app_account_index' ? 'is-active' }}">Mon compte</a>
    </li>
    <li>
        <a href="{{ path('app_account_orders') }}"
           class="{{ route starts with 'app_account_order' ? 'is-active' }}">Mes commandes</a>
    </li>
    <li>
        <a href="{{ path('app_account_profile') }}"
           class="{{ route == 'app_account_profile' ? 'is-active' }}">Mes informations</a>
    </li>
    <li>
        <a class="dash-exit" href="{{ path('app_logout') }}">Déconnexion</a>
    </li>
</ul>
