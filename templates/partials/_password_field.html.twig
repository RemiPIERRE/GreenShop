<div data-controller="password-strength">

    {{ form_row(field, {
        label: label|default('Mot de passe'),
        attr: {
            'data-password-strength-target': 'input',
            'data-action': 'input->password-strength#check'
        }
    }) }}

    <ul class="pwd-rules">
        <li data-password-strength-target="rule" data-rule="length"><span class="pwd-icon">✗</span> 8 caractères minimum
        </li>
        <li data-password-strength-target="rule" data-rule="upper"><span class="pwd-icon">✗</span> Une majuscule</li>
        <li data-password-strength-target="rule" data-rule="lower"><span class="pwd-icon">✗</span> Une minuscule</li>
        <li data-password-strength-target="rule" data-rule="digit"><span class="pwd-icon">✗</span> Un chiffre</li>
        <li data-password-strength-target="rule" data-rule="special"><span class="pwd-icon">✗</span> Un caractère
            spécial
        </li>
    </ul>
</div>
